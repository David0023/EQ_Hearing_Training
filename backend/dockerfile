FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./backend/

# RUN is during the build
RUN uv sync --project backend --locked --no-dev --no-install-project

COPY backend/ ./backend/

EXPOSE 8000

# CMD is when the container starts
CMD ["uv", "run", "--project", "backend", "--locked", "--no-sync", "uvicorn", "main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
